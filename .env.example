# Add your own key locally.
GROQ_API_KEY=

# Current Groq model used by Jarvis
JARVIS_MODEL=openai/gpt-oss-120b

# Browser is launched lazily on the first browser task.
# Valid values: chrome or brave.
JARVIS_DEFAULT_BROWSER=chrome

# Voice transcription model. Use distil-whisper-large-v3-en for English-only speed.
JARVIS_STT_MODEL=whisper-large-v3
# ISO-639-1 language code matching the language you speak to Jarvis (default: en).
# Dynamic multi-language detection/switching is not supported yet.
JARVIS_STT_LANGUAGE=en

# Voice synthesis switched from retired playai-tts to Orpheus English.
# Valid voices: autumn, diana, hannah, austin, daniel, troy
JARVIS_TTS_MODEL=canopylabs/orpheus-v1-english
JARVIS_TTS_VOICE=autumn

# Standard openWakeWord pretrained model for the phrase "hey jarvis".
# A custom .onnx or .tflite model file path may be used later if deliberately trained.
JARVIS_WAKEWORD_MODEL=hey_jarvis

# openWakeWord detection threshold (0.5 is the recommended starting point).
# Raise it for fewer false positives (but more missed wake words).
# Lower it for greater sensitivity (but potentially more false positives).
JARVIS_WAKEWORD_THRESHOLD=0.5
