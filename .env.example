# Add your own key locally.
GROQ_API_KEY=

# Current Groq model used by Jarvis
JARVIS_MODEL=openai/gpt-oss-120b

# Voice transcription model. Use distil-whisper-large-v3-en for English-only speed.
JARVIS_STT_MODEL=whisper-large-v3

# Voice synthesis model and voice
JARVIS_TTS_MODEL=playai-tts
JARVIS_TTS_VOICE=Fritz-PlayAI
